<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TempConverter.App.ViewModels"
        xmlns:conv="using:TempConverter.App.Converters"
        xmlns:core="using:TempConverter.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TempConverter.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="TempConverter"
        Width="480"
        Height="480"
        MinWidth="360"
        MinHeight="400">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:TemperatureScaleSymbolConverter x:Key="ScaleSymbolConverter" />
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                    HorizontalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="{Binding AppName}"
                       FontSize="32"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Cross-platform temperature converter"
                       FontSize="14"
                       HorizontalAlignment="Center" />
    
            <Grid ColumnDefinitions="Auto,Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  HorizontalAlignment="Center"
                  Margin="0,8,0,0">
                <TextBox x:Name="ValueInput"
                         Grid.Row="0"
                         Grid.Column="0"
                         Width="120"
                         Text="{Binding Input}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding CommitConversionCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <ComboBox x:Name="SourceScaleSelector"
                          Grid.Row="0"
                          Grid.Column="1"
                          MinWidth="76"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableScales}"
                          SelectedItem="{Binding SourceScale}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:TemperatureScale">
                            <TextBlock Text="{Binding Converter={StaticResource ScaleSymbolConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="ResultText"
                           Text="{Binding Result}"
                           Grid.Row="1"
                           Grid.Column="0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
                <ComboBox x:Name="TargetScaleSelector"
                          Grid.Row="1"
                          Grid.Column="1"
                          MinWidth="76"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableScales}"
                          SelectedItem="{Binding TargetScale}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:TemperatureScale">
                            <TextBlock Text="{Binding Converter={StaticResource ScaleSymbolConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="FormulaText"
                           Text="{Binding Formula}"
                           Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
                <StackPanel x:Name="PrecisionStepper"
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="6"
                            Margin="0,4,0,0">
                    <TextBlock x:Name="PrecisionStepperLabel"
                               Text="Decimal places"
                               VerticalAlignment="Center" />
                    <RepeatButton x:Name="DecreasePrecisionButton"
                                  Content="-"
                                  Width="30"
                                  Command="{Binding DecreasePrecisionCommand}" />
                    <TextBlock x:Name="PrecisionStepperValue"
                               Text="{Binding Precision}"
                               MinWidth="16"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <RepeatButton x:Name="IncreasePrecisionButton"
                                  Content="+"
                                  Width="30"
                                  Command="{Binding IncreasePrecisionCommand}" />
                </StackPanel>
                <TextBlock x:Name="ValidationMessage"
                           Text="{Binding ErrorMessage}"
                           Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Foreground="{DynamicResource ValidationErrorForegroundBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="260"
                           MinHeight="20"
                           Margin="0,4,0,0" />
            </Grid>
        </StackPanel>

        <DockPanel Margin="16,8">
            <Grid ColumnDefinitions="*,Auto"
                  DockPanel.Dock="Top">
                <TextBlock x:Name="HistoryHeading"
                           Text="History"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="ClearHistoryButton"
                        Grid.Column="1"
                        Content="Clear"
                        Command="{Binding ClearHistoryCommand}" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList"
                              ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ConversionHistoryEntry">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>

</Window>
