<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TempConverter.App.ViewModels"
        xmlns:conv="using:TempConverter.App.Converters"
        xmlns:core="using:TempConverter.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TempConverter.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="TempConverter"
        Width="480"
        Height="320"
        MinWidth="360"
        MinHeight="240">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:TemperatureScaleSymbolConverter x:Key="ScaleSymbolConverter" />
    </Window.Resources>

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
        <TextBlock Text="{Binding AppName}"
                   FontSize="32"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Cross-platform temperature converter"
                   FontSize="14"
                   HorizontalAlignment="Center" />

        <Grid ColumnDefinitions="Auto,Auto"
              RowDefinitions="Auto,Auto"
              HorizontalAlignment="Center"
              Margin="0,8,0,0">
            <TextBox x:Name="ValueInput"
                     Grid.Row="0"
                     Grid.Column="0"
                     Width="120"
                     Text="{Binding Input}" />
            <ComboBox x:Name="SourceScaleSelector"
                      Grid.Row="0"
                      Grid.Column="1"
                      MinWidth="76"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding AvailableScales}"
                      SelectedItem="{Binding SourceScale}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:TemperatureScale">
                        <TextBlock Text="{Binding Converter={StaticResource ScaleSymbolConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="ResultText"
                       Text="{Binding Result}"
                       Grid.Row="1"
                       Grid.Column="0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right" />
            <ComboBox x:Name="TargetScaleSelector"
                      Grid.Row="1"
                      Grid.Column="1"
                      MinWidth="76"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding AvailableScales}"
                      SelectedItem="{Binding TargetScale}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:TemperatureScale">
                        <TextBlock Text="{Binding Converter={StaticResource ScaleSymbolConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </StackPanel>

</Window>
